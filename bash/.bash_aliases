alias onedrive="cd '$HOME/onedrive/'"
alias docs="cd '$HOME/onedrive/documents'"
alias pics="cd '$HOME/onedrive/pictures'"
alias repos="cd '$HOME/onedrive/documents/programming/repos'"
alias config="cd '$HOME/onedrive/documents/programming/config'"
alias vimbashal="vim '$HOME/onedrive/documents/programming/config/bash/.bash_aliases'"
alias vimbashrc="vim '$HOME/onedrive/documents/programming/config/bash/.bashrc'"
alias srcbashal="source '$HOME/onedrive/documents/programming/config/bash/.bash_aliases'"
alias srcbashrc="source '$HOME/onedrive/documents/programming/config/bash/.bashrc'"
